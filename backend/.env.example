SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
PORT=3001
# Public URL of this backend. Used in tracking, unsubscribe and webhook links.
BASE_URL=http://localhost:3001
# Comma-separated list of allowed frontend origins (CORS). No trailing slash.
FRONTEND_URL=http://localhost:5173
# Comma-separated emails that are admins (bootstraps the first admin).
ADMIN_EMAILS=you@yourcompany.com

# Signs unsubscribe and click links. Generate once (openssl rand -base64 48) and NEVER change it.
APP_SECRET=

# Safe by default: real email is sent ONLY when this is exactly "false".
EMAIL_DRY_RUN=true
# ses (default) or resend
EMAIL_PROVIDER=ses
# Keep at or below the SES account's max send rate (sandbox: 1).
SEND_RATE_PER_SEC=1
# Used in every email footer when the organization hasn't set its own address.
DEFAULT_BUSINESS_ADDRESS=

# Amazon SES (EMAIL_PROVIDER=ses). The IAM user needs only ses:SendEmail, ses:SendRawEmail, ses:GetEmailIdentity.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=exomail-default
# SNS topic that receives SES events; /webhooks/ses only accepts messages from this topic.
SNS_TOPIC_ARN=

# Resend (EMAIL_PROVIDER=resend only)
RESEND_API_KEY=
